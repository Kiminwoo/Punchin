# Register both names under your DuckDNS account first.
DUCKDNS_DOMAINS=your-employee-name,your-admin-name
# Account-wide secret. Enter only in deploy/.env.duckdns on your own server.
DUCKDNS_TOKEN=
# Empty: DuckDNS detects the IPv4 of the request. Override with the VM public IPv4 if necessary.
DUCKDNS_IPV4=
