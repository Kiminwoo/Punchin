{
  "name": "@punchin/employee",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "native:android": "pnpm build:native && cap sync android && cap open android",
    "native:ios": "pnpm build:native && cap sync ios && cap open ios",
    "native:add:android": "cap add android",
    "native:add:ios": "cap add ios",
    "build:native": "node scripts/build-native.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "8.0.3",
    "@punchin/app": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.6"
  }
}
