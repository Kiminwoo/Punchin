{
  "name": "@punchin/employee",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "native:android": "pnpm build && cap sync android && cap open android",
