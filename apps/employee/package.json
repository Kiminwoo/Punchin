    "native:add:ios": "cap add ios"
  },
  "dependencies": {
    "@punchin/app": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@capacitor/core": "8.6.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.2.1",
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5",
    "vite": "8.3.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@capacitor/cli": "8.6.0"
  }
}
