# Copy to apps/api/.env and edit locally. Never commit the populated .env.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/punchin.sqlite
APP_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Initial bootstrap only. Fill these locally and remove ADMIN_PASSWORD after bootstrap.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Generate locally; keep stable and back it up separately from the database.
MFA_ENCRYPTION_KEY=
REQUIRE_ADMIN_MFA=false
